# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Aurora ERP
APP_VERSION=1.0.0
API_PREFIX=/api/v1
# Public URL of the web client (used for CORS + PDF links)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/aurora_erp
MONGODB_DB=aurora_erp

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=
COOKIE_SECURE=false
AUTH_RATE_LIMIT=20

# ─── Tenancy ────────────────────────────────────────────────────────────────
# The platform is shared-schema multi-tenant (organization discriminator).
# Subdomains are resolved to an organization slug when present.
TENANCY_BASE_DOMAIN=localhost
ALLOW_SUBDOMAIN_TENANCY=true

# ─── Logging / observability ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
TRUST_PROXY=1

# ─── Commercial license (optional in development) ───────────────────────────
# Issue licenses with: npm run license:generate -- --licensee="Acme" --edition=enterprise
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_ENFORCEMENT=false
LICENSE_MAX_ORGANIZATIONS=0

# ─── Business defaults ──────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0
INVOICE_DUE_DAYS=30
